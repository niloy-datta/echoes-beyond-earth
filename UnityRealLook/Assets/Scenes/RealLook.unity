--- !u!114 &1602200081
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1602200073}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 61cda14fef449ec4e9bbb8b5d8763977, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RoverShowcaseController
  rovers:
  - name: Sojourner
    missionYear: "1997 \xB7 Pathfinder"
    landingSite: Ares Vallis
    description: The first wheeled rover to explore another planet. Its compact six-wheel
      chassis carried a camera and an alpha proton X-ray spectrometer.
    provenance: "Research-informed reconstruction \xB7 NASA/JPL rover dimensions
      and layout"
    model: {fileID: 1858939400}
    parts:
    - name: Wheels & suspension
      description: Six small wheels let the lightweight rover cross rocks; rocker-bogie
        geometry was simplified for this reconstruction.
      anchor: {x: -0.62, y: 0.24, z: -0.34}
    - name: Imager mast
      description: The camera assembly returned views used to plan short Pathfinder
        traverses.
      anchor: {x: 0, y: 1.1, z: 0.18}
    - name: Solar array
      description: Photovoltaic cells on the body supplied electrical power.
      anchor: {x: 0, y: 0.7, z: 0.53}
    - name: APXS
      description: The alpha proton X-ray spectrometer measured the elemental composition
        of nearby rocks and soil.
      anchor: {x: 0.25, y: 0.62, z: -0.32}
  - name: "Spirit \xB7 MER-A"
    missionYear: "2004 \xB7 Mars Exploration Rover"
    landingSite: Gusev Crater
    description: Spirit examined rocks and soils for evidence of past water. The
      solar-powered rover used a rocker-bogie chassis and a panoramic camera mast.
    provenance: "NASA/JPL-Caltech \xB7 MER twin rover model"
    model: {fileID: 52792586}
    parts:
    - name: Wheels & rocker-bogie
      description: Six wheels and articulated suspension distributed loads across
        uneven terrain.
      anchor: {x: -0.62, y: 0.24, z: -0.34}
    - name: Pancam mast
      description: The panoramic camera pair produced color, stereo views for science
        and navigation.
      anchor: {x: 0, y: 1.1, z: 0.18}
    - name: High-gain antenna
      description: A steerable dish supported direct communication with Earth.
      anchor: {x: 0, y: 0.7, z: 0.53}
    - name: Instrument arm
      description: The robotic arm positioned science tools against selected rocks.
      anchor: {x: 0.25, y: 0.62, z: -0.32}
  - name: "Opportunity \xB7 MER-B"
    missionYear: "2004 \xB7 Mars Exploration Rover"
    landingSite: "Meridiani Planum \xB7 Endeavour Crater"
    description: Opportunity found evidence that liquid water once altered Martian
      rocks. It operated for nearly 15 years and traveled 45.16 km.
    provenance: "NASA/JPL-Caltech \xB7 official MER reference model"
    model: {fileID: 522716440}
    parts:
    - name: Wheels & rocker-bogie
      description: Six wheels and articulated suspension enabled slow, stable travel
        over rough ground.
      anchor: {x: -0.62, y: 0.24, z: -0.34}
    - name: Pancam mast
      description: The stereo panoramic cameras documented geology and helped choose
        targets.
      anchor: {x: 0, y: 1.1, z: 0.18}
    - name: High-gain antenna
      description: The dish relayed mission data directly to Earth when geometry
        allowed.
      anchor: {x: 0, y: 0.7, z: 0.53}
    - name: Instrument arm
      description: The arm carried the microscopic imager and contact science instruments.
      anchor: {x: 0.25, y: 0.62, z: -0.32}
  - name: "Curiosity \xB7 MSL"
    missionYear: "2012 \xB7 Mars Science Laboratory"
    landingSite: "Gale Crater \xB7 Mount Sharp"
    description: A car-sized mobile laboratory studying the habitability and geology
      of Gale Crater with a laser, drill, cameras and onboard analytical instruments.
    provenance: "NASA/JPL-Caltech \xB7 official Curiosity model"
    model: {fileID: 400507658}
    parts:
    - name: Wheels & rocker-bogie
      description: Six cleated aluminum wheels and rocker-bogie suspension carry
        the one-ton rover.
      anchor: {x: -0.62, y: 0.24, z: -0.34}
    - name: Remote sensing mast
      description: Mast cameras and ChemCam observe terrain and analyze distant targets.
      anchor: {x: 0, y: 1.1, z: 0.18}
    - name: Robotic arm & turret
      description: The arm positions a drill, brush, and contact instruments at rock
        targets.
      anchor: {x: 0, y: 0.7, z: 0.53}
    - name: RTG power system
      description: A radioisotope thermoelectric generator supplies power and heat.
      anchor: {x: 0.25, y: 0.62, z: -0.32}
  - name: "Perseverance \xB7 Mars 2020"
    missionYear: "2021 \xB7 Mars 2020"
    landingSite: Jezero Crater
    description: Perseverance studies ancient environments and collects sealed samples
      for possible future return. Its upgraded chassis carries a sample caching system.
    provenance: "NASA/JPL-Caltech \xB7 official Perseverance model"
    model: {fileID: 1461536811}
    parts:
    - name: Wheels & rocker-bogie
      description: Six redesigned wheels and rocker-bogie suspension handle the Jezero
        terrain.
      anchor: {x: -0.62, y: 0.24, z: -0.34}
    - name: Mast cameras
      description: Mastcam-Z provides zoomable stereo images; SuperCam studies distant
        targets.
      anchor: {x: 0, y: 1.1, z: 0.18}
    - name: Sampling arm & coring drill
      description: The arm drills, handles sample tubes and places them in the caching
        system.
      anchor: {x: 0, y: 0.7, z: 0.53}
    - name: MMRTG power system
      description: A multi-mission radioisotope thermoelectric generator supplies
        electrical power and heat.
      anchor: {x: 0.25, y: 0.62, z: -0.32}
  sceneCamera: {fileID: 634066654}
  astronaut: {fileID: 169356207}
  shotDirector: {fileID: 1602200076}
  selectedIndex: 2
  orbitDistance: 4.6
  orbitYaw: 214
  orbitPitch: 13
  zoomMin: 2
  zoomMax: 12
