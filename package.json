{
  "name": "echoes-beyond-earth",
  "version": "0.1.0",
  "private": true,
  "author": "niloy-datta",
  "repository": {
    "type": "git",
    "url": "https://github.com/niloy-datta/echoes-beyond-earth.git"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs && node scripts/copy-draco-decoder.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs && node scripts/copy-draco-decoder.mjs && node scripts/validate-data.mjs",
    "build": "next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-data.mjs",
    "postbuild": "node scripts/flatten-prefetch.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:demo": "node scripts/test-judge-demo.mjs",
    "quality:eko": "node --experimental-strip-types scripts/check-eko-quality.mjs",
    "assets:build": "node scripts/assets/build-all.mjs"
  },
  "dependencies": {
    "framer-motion": "^14.0.0",
    "maplibre-gl": "^6.13.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "meshoptimizer": "^1.3.0",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
